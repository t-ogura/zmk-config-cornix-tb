+// Cornix TB local patch (v3): scan duty backoff state. `scan_slow` selects
+// the 10%-duty parameters in start_scanning; the watchdog flips it after
+// SCAN_BACKOFF_TICKS of fruitless fast scanning and the activity listener
+// flips it back on wake so a waking half reconnects fast.
+#define SCAN_SLOW_INTERVAL 0x01E0 // 300ms units of 0.625ms -> 480 = 0x1E0
+static bool scan_slow = false;
+
 static int start_scanning(void) {
     if (!is_enabled) {
         LOG_DBG("Not scanning, we're disabled");
@@ -908,17 +916,138 @@ static int start_scanning(void) {
     }
 
     // Start scanning otherwise.
-    is_scanning = true;
-    int err = bt_le_scan_start(BT_LE_SCAN_PASSIVE, split_central_device_found);
+    // Cornix TB local patch (v3):
+    //   1) set is_scanning AFTER bt_le_scan_start succeeds, so a transient
+    //      failure (e.g. controller busy at boot) does not leave is_scanning
+    //      stuck true and prevent future scan attempts.
+    //   2) two-phase duty cycle (see scan_slow / watchdog): FAST phase is a
+    //      continuous passive scan (30ms window == interval, 100% duty) so a
+    //      waking peripheral's undirected adv (~100-150ms) is caught
+    //      immediately; after SCAN_BACKOFF_TICKS without full connection the
+    //      watchdog drops to a 10%-duty SLOW scan (30ms window / 300ms
+    //      interval). 100% RX duty costs ~5-6mA -- fine for a brief
+    //      reconnect window, ruinous when a sleeping half leaves the slot
+    //      open for hours while the user keeps mousing on the central
+    //      (trackball-as-central battery drain).
+    //   3) NO duplicate filtering (BT_LE_SCAN_OPT_NONE instead of
+    //      BT_LE_SCAN_OPT_FILTER_DUPLICATE): the controller's duplicate-adv
+    //      filter could latch a peripheral as "already seen" after a failed
+    //      connect attempt, silently dropping its subsequent advs. Patch v1
+    //      worked around that with a periodic scan stop+start cycle, but
+    //      issuing scan commands from a timer raced ZMK's own scan/initiator
+    //      state machine (freeze at wake+5s on the xiao-as-central build).
+    //      Without the filter the latch cannot happen; the extra duplicate
+    //      reports are cheap to discard in split_central_device_found.
+    int err = bt_le_scan_start(
+        scan_slow ? BT_LE_SCAN_PARAM(BT_LE_SCAN_TYPE_PASSIVE, BT_LE_SCAN_OPT_NONE,
+                                     SCAN_SLOW_INTERVAL, BT_GAP_SCAN_FAST_WINDOW)
+                  : BT_LE_SCAN_PARAM(BT_LE_SCAN_TYPE_PASSIVE, BT_LE_SCAN_OPT_NONE,
+                                     BT_GAP_SCAN_FAST_WINDOW, BT_GAP_SCAN_FAST_WINDOW),
+        split_central_device_found);
     if (err < 0) {
         LOG_ERR("Scanning failed to start (err %d)", err);
+        is_scanning = false;
         return err;
     }
+    is_scanning = true;
+    LOG_INF("Scanning started (%s duty)", scan_slow ? "slow 10%" : "fast 100%");
 
     LOG_DBG("Scanning successfully started");
     return 0;
 }
 
+/*
+ * Cornix TB local patch (v2): periodic scan RECOVERY (watchdog), not refresh.
+ *
+ * v1 rationale was resetting the controller's duplicate-adv filter with a
+ * stop+start cycle every 5s while any peripheral was unconnected. That
+ * issued bt_le_scan_stop()/bt_le_scan_start() from the system workqueue
+ * with no synchronization against ZMK's own scan/initiator transitions
+ * (split_central_eir_found stops the scan and hands the LL scanner to the
+ * initiator for up to CONFIG_BT_CREATE_CONN_TIMEOUT seconds). When the
+ * kick collided with that window -- deterministic on the xiao-as-central
+ * build at wake+5s, where the halves wake and start advertising seconds
+ * after the central reboots -- the host wedged on the HCI command and the
+ * system workqueue blocked forever (total input/adv/LED freeze).
+ *
+ * v2 removes the need for the churn at the source: scanning now runs
+ * without duplicate filtering (see start_scanning), so the filter can
+ * never latch. The kick degrades to a pure recovery watchdog:
+ *   - never stops a running scan;
+ *   - only calls start_scanning() when the scan is NOT running, at least
+ *     one peripheral slot is empty, and no connection attempt is in
+ *     flight (a slot conn in a non-connected state = initiator active,
+ *     which owns the LL scanner -- starting a scan then is the exact
+ *     race v1 died on);
+ *   - re-arms itself every PERIODIC_SCAN_KICK_SECONDS.
+ */
+#define PERIODIC_SCAN_KICK_SECONDS 5
+
+static void periodic_scan_kick_work_handler(struct k_work *work);
+static K_WORK_DELAYABLE_DEFINE(periodic_scan_kick_work, periodic_scan_kick_work_handler);
+
+// Ticks of fruitless FAST scanning before dropping to the 10%-duty SLOW
+// scan (12 ticks x 5s = 60s). Long enough that every normal reconnect
+// happens at full duty, short enough that a half left asleep for hours
+// does not pin the radio RX on continuously.
+#define SCAN_BACKOFF_TICKS 12
+static uint8_t scan_fast_ticks = 0;
+
+static void survey_peripheral_slots(bool *has_unconnected, bool *create_in_flight) {
+    *has_unconnected = false;
+    *create_in_flight = false;
+    for (int i = 0; i < CONFIG_ZMK_SPLIT_BLE_CENTRAL_PERIPHERALS; i++) {
+        if (peripherals[i].conn == NULL) {
+            *has_unconnected = true;
+        } else {
+            struct bt_conn_info info;
+            if (bt_conn_get_info(peripherals[i].conn, &info) == 0 &&
+                info.state != BT_CONN_STATE_CONNECTED) {
+                *create_in_flight = true;
+            }
+        }
+    }
+}
+
+// Guarded one-shot scan restart, used only for duty transitions. Unlike the
+// v1 5s churn this runs at most once per transition, never while a connect
+// is in flight, and tolerates losing the race to split_central_eir_found
+// (stop returns -EALREADY, the follow-up start fails cleanly, and the next
+// watchdog tick recovers).
+static void restart_scan_for_duty_change(void) {
+    if (is_scanning) {
+        is_scanning = false;
+        int err = bt_le_scan_stop();
+        if (err < 0 && err != -EALREADY) {
+            LOG_WRN("duty change: stop scan failed (%d)", err);
+        }
+    }
+    start_scanning();
+}
+
+static void periodic_scan_kick_work_handler(struct k_work *work) {
+    bool has_unconnected, create_in_flight;
+    survey_peripheral_slots(&has_unconnected, &create_in_flight);
+
+    if (!has_unconnected) {
+        // Fully connected: reset backoff so the next disconnect starts fast.
+        scan_fast_ticks = 0;
+        scan_slow = false;
+    } else if (is_enabled && !create_in_flight) {
+        if (!is_scanning) {
+            LOG_INF("scan watchdog: scan not running with open slots, restarting");
+            start_scanning();
+        } else if (!scan_slow && ++scan_fast_ticks >= SCAN_BACKOFF_TICKS) {
+            LOG_INF("scan watchdog: backing off to slow scan after %ds",
+                    SCAN_BACKOFF_TICKS * PERIODIC_SCAN_KICK_SECONDS);
+            scan_slow = true;
+            restart_scan_for_duty_change();
+        }
+    }
+
+    k_work_schedule(&periodic_scan_kick_work, K_SECONDS(PERIODIC_SCAN_KICK_SECONDS));
+}
