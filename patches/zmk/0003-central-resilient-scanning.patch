+/*
+ * Cornix TB local patch: periodic scan refresh.
+ *
+ * The BLE controller's duplicate-adv filter can latch a peripheral as
+ * "already seen" after a failed/abandoned connect attempt, so its subsequent
+ * adv beacons are silently dropped before reaching this driver. Restarting
+ * the scan resets the filter. We schedule a periodic kick that:
+ *   - if any peripheral slot is still unconnected, stop + start scanning
+ *   - is a no-op once all peripherals are connected
+ *   - re-arms itself every PERIODIC_SCAN_KICK_SECONDS until cancelled
+ *
+ * 5 seconds is short enough that "right keyboard doesn't connect" recovers
+ * within the user's normal post-boot wait, long enough that we don't churn
+ * the radio for nothing.
+ */
+#define PERIODIC_SCAN_KICK_SECONDS 5
+
+static void periodic_scan_kick_work_handler(struct k_work *work);
+static K_WORK_DELAYABLE_DEFINE(periodic_scan_kick_work, periodic_scan_kick_work_handler);
+
+static void periodic_scan_kick_work_handler(struct k_work *work) {
+    bool has_unconnected = false;
+    for (int i = 0; i < CONFIG_ZMK_SPLIT_BLE_CENTRAL_PERIPHERALS; i++) {
+        if (peripherals[i].conn == NULL) {
+            has_unconnected = true;
+            break;
+        }
+    }
+
+    if (has_unconnected && is_enabled) {
+        if (is_scanning) {
+            int err = bt_le_scan_stop();
+            if (err < 0 && err != -EALREADY) {
+                LOG_WRN("periodic kick: stop scan failed (%d)", err);
+            }
+            is_scanning = false;
+        }
+        start_scanning();
+    }
+
+    k_work_schedule(&periodic_scan_kick_work, K_SECONDS(PERIODIC_SCAN_KICK_SECONDS));
+}
