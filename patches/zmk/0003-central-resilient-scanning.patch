+
 #if IS_ENABLED(CONFIG_SETTINGS)
     settings_register(&ble_central_settings_handler);
     return 0;
@@ -1161,11 +1293,36 @@ static int zmk_split_bt_central_listener_cb(const zmk_event_t *eh) {
     if (as_zmk_physical_layout_selection_changed(eh)) {
         k_work_submit(&update_peripherals_selected_layouts_work);
     }
+    /*
+     * Cornix TB local patch (v3): on transition back to the ACTIVE activity
+     * state (key press / movement after idle/sleep), kick start_scanning()
+     * again -- if scanning stalled there is otherwise no path back without a
+     * hard reset. Additionally, drop out of the slow-scan backoff: renewed
+     * user activity is the moment a sleeping half is most likely to wake and
+     * advertise, so we want the fast 100%-duty scan for a quick reconnect.
+     * The duty-change restart honors the same in-flight-connect guard as the
+     * watchdog.
+     */
+    struct zmk_activity_state_changed *as_ev = as_zmk_activity_state_changed(eh);
+    if (as_ev && as_ev->state == ZMK_ACTIVITY_ACTIVE) {
+        scan_fast_ticks = 0;
+        if (scan_slow) {
+            scan_slow = false;
+            bool has_unconnected, create_in_flight;
+            survey_peripheral_slots(&has_unconnected, &create_in_flight);
+            if (has_unconnected && !create_in_flight) {
+                restart_scan_for_duty_change();
+            }
+        } else {
+            start_scanning();
+        }
+    }
     return ZMK_EV_EVENT_BUBBLE;
 }
 
