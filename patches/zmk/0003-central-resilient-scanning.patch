+/*
+ * Cornix TB local patch (v2): periodic scan RECOVERY (watchdog), not refresh.
+ *
+ * v1 rationale was resetting the controller's duplicate-adv filter with a
+ * stop+start cycle every 5s while any peripheral was unconnected. That
+ * issued bt_le_scan_stop()/bt_le_scan_start() from the system workqueue
+ * with no synchronization against ZMK's own scan/initiator transitions
+ * (split_central_eir_found stops the scan and hands the LL scanner to the
+ * initiator for up to CONFIG_BT_CREATE_CONN_TIMEOUT seconds). When the
+ * kick collided with that window -- deterministic on the xiao-as-central
+ * build at wake+5s, where the halves wake and start advertising seconds
+ * after the central reboots -- the host wedged on the HCI command and the
+ * system workqueue blocked forever (total input/adv/LED freeze).
+ *
+ * v2 removes the need for the churn at the source: scanning now runs
+ * without duplicate filtering (see start_scanning), so the filter can
+ * never latch. The kick degrades to a pure recovery watchdog:
+ *   - never stops a running scan;
+ *   - only calls start_scanning() when the scan is NOT running, at least
+ *     one peripheral slot is empty, and no connection attempt is in
+ *     flight (a slot conn in a non-connected state = initiator active,
+ *     which owns the LL scanner -- starting a scan then is the exact
+ *     race v1 died on);
+ *   - re-arms itself every PERIODIC_SCAN_KICK_SECONDS.
+ */
+#define PERIODIC_SCAN_KICK_SECONDS 5
+
+static void periodic_scan_kick_work_handler(struct k_work *work);
+static K_WORK_DELAYABLE_DEFINE(periodic_scan_kick_work, periodic_scan_kick_work_handler);
+
+static void periodic_scan_kick_work_handler(struct k_work *work) {
+    bool has_unconnected = false;
+    bool create_in_flight = false;
+    for (int i = 0; i < CONFIG_ZMK_SPLIT_BLE_CENTRAL_PERIPHERALS; i++) {
+        if (peripherals[i].conn == NULL) {
+            has_unconnected = true;
+        } else {
+            struct bt_conn_info info;
+            if (bt_conn_get_info(peripherals[i].conn, &info) == 0 &&
+                info.state != BT_CONN_STATE_CONNECTED) {
+                create_in_flight = true;
+            }
+        }
+    }
+
+    if (has_unconnected && is_enabled && !is_scanning && !create_in_flight) {
+        LOG_INF("scan watchdog: scan not running with open slots, restarting");
+        start_scanning();
+    }
+
+    k_work_schedule(&periodic_scan_kick_work, K_SECONDS(PERIODIC_SCAN_KICK_SECONDS));
+}
