// Right-as-central overlay: trackball input listener now lives on right
// (central side) because the peripheral side (here = left) cannot receive
// split input from the trackball. Mirrors what cornix_left.overlay does on
// the original left-central build.
#include <dt-bindings/zmk/input_transform.h>

&zephyr_udc0 {
    cdc_acm_uart0: cdc_acm_uart0 {
        compatible = "zephyr,cdc-acm-uart";
    };
};

/{
    split_inputs {
        #address-cells = <1>;
        #size-cells = <0>;

        trackball_split: trackball_split@0 {
            compatible = "zmk,input-split";
            reg = <0>;
        };
    };

    trackball_listener: trackball_listener {
        compatible = "zmk,input-listener";
        device = <&trackball_split>;
        status = "okay";

        // Input processors (auto-mouse layer trigger + scroller child) are
        // configured in cornix_left.keymap, which cornix_right.keymap
        // re-includes. They cannot live in this overlay because Zephyr does
        // not feed autoconf.h to the overlay CPP, so a guard like
        // `#if defined(CONFIG_ZMK_POINTING)` would always strip them out.
        // The keymap path also keeps settings_reset shield builds clean,
        // since settings_reset does not load the application keymap.
    };

    chosen {
        zephyr,console = &cdc_acm_uart0;
    };
};
